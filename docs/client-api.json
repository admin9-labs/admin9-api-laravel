        "schemas": {
            "ChangePasswordRequest": {
                "type": "object",
                "properties": {
                    "current_password": {
                        "type": "string"
                    },
                    "password": {
                        "type": "string",
                        "description": "8–255 characters. With bcrypt, the password must not exceed 72 bytes (or a stricter configured byte limit) and must not contain NUL bytes. Other hash drivers retain the character-length limit.",
                        "minLength": 8,
                        "maxLength": 255
                    },
                    "password_confirmation": {
                        "type": "string",
                        "description": "8–255 characters. With bcrypt, the password must not exceed 72 bytes (or a stricter configured byte limit) and must not contain NUL bytes. Other hash drivers retain the character-length limit.",
                        "minLength": 8,
                        "maxLength": 255
                    }
                },
                "required": [
                    "current_password",
                    "password",
                    "password_confirmation"
                ],
                "title": "ChangePasswordRequest"
            },
            "LoginRequest": {
                "type": "object",
                "properties": {
                    "account": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "password": {
                        "type": "string"
                    }
                },
                "required": [
                    "account",
                    "password"
                ],
                "title": "LoginRequest"
            },
            "MemberResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "email": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "mobile": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "is_active": {
                        "type": "boolean"
                    },
                    "last_login_at": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                },
                "required": [
                    "id",
                    "name",
                    "email",
                    "mobile",
                    "is_active",
                    "last_login_at"
                ],
                "title": "MemberResource"
            },
            "SystemSettingsResource": {
                "type": "object",
                "properties": {
                    "basic": {
                        "type": "object",
                        "properties": {
                            "system_name": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "copyright": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "icp_filing_number": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            }
                        },
                        "required": [
                            "system_name",
                            "copyright",
                            "icp_filing_number"
                        ]
                    },
                    "branding": {
                        "type": "object",
                        "properties": {
                            "navigation_logo_url": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "format": "uri",
                                "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://(?![^/?#]*@)",
                                "maxLength": 2048
                            },
                            "login_logo_url": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "format": "uri",
                                "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://(?![^/?#]*@)",
                                "maxLength": 2048
                            },
                            "login_background_url": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "format": "uri",
                                "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://(?![^/?#]*@)",
                                "maxLength": 2048
                            },
                            "favicon_url": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "format": "uri",
                                "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://(?![^/?#]*@)",
                                "maxLength": 2048
                            }
                        },
                        "required": [
                            "navigation_logo_url",
                            "login_logo_url",
                            "login_background_url",
                            "favicon_url"
                        ]
                    }
                },
                "required": [
                    "basic",
                    "branding"
                ],
                "title": "SystemSettingsResource"
            }
        },
